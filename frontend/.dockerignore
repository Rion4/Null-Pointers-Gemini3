# Build artifacts — Docker rebuilds these inside the container
.next
out

# Dependencies — Docker installs these from package.json
node_modules

# Use npm (package-lock.json) in Docker — pnpm 11 requires Node 22+
# which conflicts with the node:20-alpine base image
pnpm-lock.yaml

# Dev/local files
.env*.local
.env.development
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor/OS
.DS_Store
.vscode
*.swp
*.swo

# Git
.git
.gitignore
