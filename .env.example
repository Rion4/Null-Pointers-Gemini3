# ── Authentication ────────────────────────────────────────────────────────────
# Option A: Vertex AI (recommended for production)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Gemini API key (local dev / no GCP)
# GOOGLE_GENAI_USE_VERTEXAI=0
# GOOGLE_API_KEY=your-gemini-api-key

# ── Model config ──────────────────────────────────────────────────────────────
# Orchestrator + persona agents
GUARDIAN_MODEL=gemini-2.5-flash
GUARDIAN_MODEL_FAST=gemini-2.5-flash
# Critic — faster model, still accurate for validation
# Vertex AI: gemini-2.0-flash | API key: gemini-2.0-flash-001
GUARDIAN_MODEL_CRITIC=gemini-2.0-flash

# ── Session persistence ───────────────────────────────────────────────────────
# SQLite (local dev) — aiosqlite driver required
GUARDIAN_DB_URL=sqlite+aiosqlite:///./guardian_sessions.db
# Cloud SQL (production) — example:
# GUARDIAN_DB_URL=postgresql+asyncpg://user:pass@/dbname?host=/cloudsql/project:region:instance
